<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" minHeight="500.0" minWidth="800.0" prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.proyectogestioneventos.controller.HistorialComprasController">
   <children>
      <Label text="Historial de Compras" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="25.0">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <VBox layoutX="30.0" layoutY="60.0" spacing="10.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="60.0">
         <children>
            <Label text="Filtros:" />
            <HBox spacing="10.0">
               <children>
                  <DatePicker fx:id="campoFecha" promptText="Fecha" />
                  <TextField fx:id="campoEvento" promptText="Nombre Evento" />
                  <ComboBox fx:id="cbEstado" prefWidth="150.0" promptText="Estado" />
                  <Button mnemonicParsing="false" onAction="#onFiltrarClick" text="Filtrar" />
               </children>
            </HBox>
         </children>
      </VBox>
      <TableView fx:id="tablaCompras" AnchorPane.bottomAnchor="80.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="150.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="100.0" text="ID Compra" />
          <TableColumn fx:id="colEvento" prefWidth="200.0" text="Evento" />
            <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha Compra" />
            <TableColumn fx:id="colTotal" prefWidth="100.0" text="Total" />
            <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER_RIGHT" spacing="10.0" AnchorPane.bottomAnchor="30.0" AnchorPane.rightAnchor="30.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onVerDetalleClick" text="Ver Detalle" />
            <Button mnemonicParsing="false" onAction="#onDescargarReporteClick" text="Descargar Reporte" />
            <Button mnemonicParsing="false" onAction="#onVolverClick" text="Volver al Panel" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</AnchorPane>