<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" minHeight="500.0" minWidth="800.0" prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proyectogestioneventos.controller.MisComprasController">
   <children>
      <Label text="Mis Compras Activas" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="25.0">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <TableView fx:id="tablaMisCompras" AnchorPane.bottomAnchor="110.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="70.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="100.0" text="ID Compra" />
          <TableColumn fx:id="colEvento" prefWidth="200.0" text="Evento" />
            <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha Creación" />
            <TableColumn fx:id="colTotal" prefWidth="100.0" text="Total" />
            <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Button onAction="#onVerDetalleCompraClick" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold;" text="VER DETALLE" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="30.0" />
      <Button onAction="#onCancelarCompraClick" prefHeight="40.0" prefWidth="150.0" style="-fx-border-color: #e74c3c; -fx-text-fill: #e74c3c; -fx-background-color: white;" text="CANCELAR COMPRA" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="200.0" />
      <Button onAction="#onVolverClick" text="Volver al Panel" AnchorPane.bottomAnchor="20.0" AnchorPane.rightAnchor="30.0" />
   </children>
</AnchorPane>
