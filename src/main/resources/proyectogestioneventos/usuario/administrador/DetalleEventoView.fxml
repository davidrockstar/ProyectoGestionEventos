<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proyectogestioneventos.controller.DetalleEventoController">
   <children>
      <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Text fx:id="lblNombreEvento" strokeType="OUTSIDE" strokeWidth="0.0" text="Nombre del Evento">
                     <font>
                        <Font name="System Bold" size="28.0" />
                     </font>
                  </Text>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblEstado" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 5 10; -fx-background-radius: 5;" text="ESTADO" />
               </children>
            </HBox>
            <Separator prefWidth="200.0" />
            <GridPane hgap="10.0" vgap="10.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Ciudad:" GridPane.rowIndex="0">
                     <font><Font name="System Bold" size="14.0" /></font>
                  </Label>
                  <Label fx:id="lblCiudad" text="--" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label text="Fecha y Hora:" GridPane.columnIndex="2" GridPane.rowIndex="0">
                     <font><Font name="System Bold" size="14.0" /></font>
                  </Label>
                  <Label fx:id="lblFechaHora" text="--" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                  <Label text="Recinto:" GridPane.rowIndex="1">
                     <font><Font name="System Bold" size="14.0" /></font>
                  </Label>
                  <Label fx:id="lblRecinto" text="--" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Capacidad:" GridPane.columnIndex="2" GridPane.rowIndex="1">
                     <font><Font name="System Bold" size="14.0" /></font>
                  </Label>
                  <Label fx:id="lblAforo" text="--" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                  <Label text="Categoría:" GridPane.rowIndex="2">
                     <font><Font name="System Bold" size="14.0" /></font>
                  </Label>
                  <Label fx:id="lblCategoria" text="--" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               </children>
            </GridPane>
            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox spacing="10.0" HBox.hgrow="SOMETIMES">
                     <children>
                        <Label text="Descripción:" style="-fx-font-weight: bold;" />
                        <TextArea fx:id="txtDescripcion" editable="false" prefHeight="150.0" wrapText="true" />
                        <Label text="Reglas del Evento:" style="-fx-font-weight: bold;" />
                        <TextArea fx:id="txtReglas" editable="false" prefHeight="100.0" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox spacing="10.0" HBox.hgrow="SOMETIMES">
                     <children>
                        <Label text="Zonas y Precios:" style="-fx-font-weight: bold;" />
                        <TextArea fx:id="txtZonasPrecios" editable="false" prefHeight="260.0" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onVolverClick" prefHeight="40.0" prefWidth="120.0" text="Volver" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>